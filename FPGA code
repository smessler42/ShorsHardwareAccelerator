module hadamard_gate(
  input logic qbit [1][2],
  output logic qbit_new [1][2]
)
  logic hadamard_gate [2][2] = '{
    '{1, 1},
    '{1, -1}
  };
  
  matrix_mult(hadamard_gate, qbit, qbit_new);
endmodule 

module x_flip(
  input logic qbit [1][2],
  output logic qbit_new [1][2]
)
  logic x_gate [2][2] = '{
    '{0, 1},
    '{1, 0}
  };
  
  matrix_mult(x_gate, qbit, qbit_new);
endmodule 

module z_flip(
  input logic qbit [1][2],
  output logic qbit_new [1][2]
)
  logic z_gate [2][2] = '{
    '{1, 0},
    '{0, -1}
  };
  
  matrix_mult(z_gate, qbit, qbit_new);
endmodule 

module shors_error_check(
  input logic qbit [1][2],
  input logic x_flip, 
  input logic z_flip, 
  input logic location [2:0],
  output logic error_bit1,
  output logic error_bit2
);

  logic qbit1[1][2];
  logic qbit2[1][2];
  logic qbit3[1][2]; 
  logic qbit4[1][2];
  logic qbit5[1][2];
  logic qbit6[1][2];
  logic qbit7[1][2];
  logic qbit8[1][2];
  
  entangle(qbit, qbit1);
  entangle(qbit, qbit2);
  
  logic qbit_h[1][2];
  logic qbit1_h[1][2];
  logic qbit2_h[1][2];
  //hadamard gates initial phase
  hadamard_gate(qbit, qbit_h);
  hadamard_gate(qbit1, qbit1_h);
  hadamard_gate(qbit2, qbit2_h);

  //qbit_h refers to initial qbit post hadamard gate
  entangle(qbit_h, qbit3);
  entangle(qbit_h, qbit4);
  entangle(qbit1_h, qbit5);
  entangle(qbit1_h, qbit6);
  entangle(qbit2_h, qbit7);
  entangle(qbit2_h, qbit8);

  //error generation
  if (location = 3'b000) begin 
    if (x_flip = 1'b1) begin
      x_flip(qbit_h); 
    end 
    if (z_flip = 1'b1) begin 
      z_flip(qbit_h); 
    end
  end 
  else if (location = 3'b001) begin 
    if (x_flip = 1'b1) begin
      x_flip(qbit3); 
    end 
    if (z_flip = 1'b1) begin 
      z_flip(qbit3); 
    end
  end 
  else if (location = 3'b010) begin 
    if (x_flip = 1'b1) begin
      x_flip(qbit4); 
    end 
    if (z_flip = 1'b1) begin 
      z_flip(qbit4); 
    end
  end
  else if (location = 3'b011) begin 
    if (x_flip = 1'b1) begin
      x_flip(qbit1_h); 
    end 
    if (z_flip = 1'b1) begin 
      z_flip(qbit1_h); 
    end
  end
else if (location = 3'b100) begin 
    if (x_flip = 1'b1) begin
      x_flip(qbit5); 
    end 
    if (z_flip = 1'b1) begin 
      z_flip(qbit5); 
    end
  end
else if (location = 3'b101) begin 
    if (x_flip = 1'b1) begin
      x_flip(qbit6); 
    end 
    if (z_flip = 1'b1) begin 
      z_flip(qbit6); 
    end
  end
else if (location = 3'b110) begin 
    if (x_flip = 1'b1) begin
      x_flip(qbit2_h); 
    end 
    if (z_flip = 1'b1) begin 
      z_flip(qbit2_h); 
    end
  end
else if (location = 3'b110) begin 
    if (x_flip = 1'b1) begin
      x_flip(qbit7); 
    end 
    if (z_flip = 1'b1) begin 
      z_flip(qbit7); 
    end
  end
else if (location = 3'b111) begin 
    if (x_flip = 1'b1) begin
      x_flip(qbit8); 
    end 
    if (z_flip = 1'b1) begin 
      z_flip(qbit8); 
    end
  end



endmodule
